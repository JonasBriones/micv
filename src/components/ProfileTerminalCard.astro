---
const details = [
  { label: 'Base', value: 'Valladolid (Castilla y León), España' },
  { label: 'Modalidad', value: 'Híbrida o remota' },
  { label: 'Idioma', value: 'Español nativo' },
  { label: 'Enfoco', value: 'AWS, Terraform, Kubernetes, FinOps' }
];
---
<div class="relative">
  <div class="absolute -inset-3 rounded-[2rem] bg-bg-soft" aria-hidden="true"></div>
  <div class="relative rounded-2xl border border-line bg-bg-card p-6 shadow-card sm:p-8">
    <div class="mb-6 flex items-center gap-2 text-xs text-ink-muted">
      <span class="h-2.5 w-2.5 rounded-full bg-[#e0a458]" aria-hidden="true"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-[#c9c2b5]" aria-hidden="true"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-[#8fa68a]" aria-hidden="true"></span>
      <span class="ml-2 font-sans">~/perfil</span>
    </div>
    <p class="font-mono text-xs text-accent">$ whoami</p>
    <h2 class="mt-2 font-display text-2xl font-semibold leading-tight">Jonathan Briones Lavados</h2>
    <p class="mt-2 text-sm leading-relaxed text-ink-muted">Líder Técnico · Arquitecto Cloud · DevOps &amp; FinOps. Equipos multidisciplinares, proyectos críticos y transformación digital.</p>
    <dl class="mt-7 space-y-3 border-t border-line pt-6 text-sm">
      {details.map((detail) => (
        <div class="flex gap-4">
          <dt class="w-24 shrink-0 text-ink-muted">{detail.label}</dt>
          <dd>{detail.value}</dd>
        </div>
      ))}
    </dl>
    <a href="#contacto" class="mt-7 inline-flex items-center gap-2 text-sm font-medium text-accent hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
      Disponible para colaborar
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg>
    </a>
  </div>
</div>
