---
interface Props {
  period: string;
  company: string;
  role: string;
  panelId: string;
  body?: string;
  items?: string[];
  expanded?: boolean;
  last?: boolean;
}
const { period, company, role, panelId, body, items = [], expanded = false, last = false } = Astro.props;
---
<article class:list={['relative', !last && 'pb-8']}>
  <span class="absolute -left-[31px] top-2 h-3 w-3 rounded-full bg-accent ring-4 ring-bg sm:-left-[39px]" aria-hidden="true"></span>
  <button type="button" class="acc-trigger group flex w-full items-start justify-between gap-4 rounded-lg text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent" aria-expanded={expanded ? 'true' : 'false'} aria-controls={panelId}>
    <span>
      <span class="block text-xs font-medium uppercase tracking-wider text-accent">{period}</span>
      <span class="mt-1 block font-display text-xl font-semibold group-hover:text-accent">{company}</span>
      <span class="mt-0.5 block text-sm text-ink-muted">{role}</span>
    </span>
    <svg class="acc-chevron mt-2 h-5 w-5 shrink-0 text-ink-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" /></svg>
  </button>
  <div id={panelId} class:list={['acc-panel', expanded && 'open']}>
    <div>
      {body && <p class="pt-3 text-sm leading-relaxed text-ink-muted">{body}</p>}
      {items.length > 0 && (
        <ul class="list-disc space-y-1.5 pt-3 pl-5 text-sm leading-relaxed text-ink-muted">
          {items.map((item) => <li>{item}</li>)}
        </ul>
      )}
    </div>
  </div>
</article>
