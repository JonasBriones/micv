---
const year = new Date().getFullYear();
const isHome = Astro.url.pathname === '/';
---
{isHome ? (
  <footer class="bg-bg px-5 py-8 sm:px-8">
    <div class="mx-auto flex max-w-6xl flex-col justify-between gap-3 border-t border-line pt-6 text-xs text-ink-muted sm:flex-row">
      <p>© {year} Jonathan Briones · Valladolid, España</p>
      <p>Diseño propio: Fraunces + Inter, fondo papel y azul marino. Web personal separada de Pisuerga Digital y Sazón.</p>
    </div>
  </footer>
) : (
  <footer class="mt-16 border-t border-line">
    <div class="wrap flex flex-col items-center justify-between gap-3 py-8 text-sm text-ink-muted sm:flex-row">
      <p>&copy; {year} Jonathan Briones. Escrito desde Valladolid.</p>
      <div class="flex gap-4">
        <a href="https://www.linkedin.com/in/jonathan-patricio-briones-lavados" class="hover:text-accent" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://github.com/JonasBriones" class="hover:text-accent" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="/contacto" class="hover:text-accent">Contacto</a>
      </div>
    </div>
  </footer>
)}
