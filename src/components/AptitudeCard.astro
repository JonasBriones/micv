---
interface Props {
  num: string;
  title: string;
  body: string;
}
const { num, title, body } = Astro.props;
---
<article class="rounded-2xl border border-line bg-bg-card p-6">
  <span class="font-display text-2xl text-accent" aria-hidden="true">{num}</span>
  <h3 class="mt-3 font-display text-lg font-semibold">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-ink-muted">{body}</p>
</article>
