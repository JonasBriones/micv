---
const nav = [
  { href: '/', label: 'Inicio' },
  { href: '/sobre-mi', label: 'Sobre mí' },
  { href: '/blog', label: 'Blog' },
  { href: '/proyectos', label: 'Proyectos' },
  { href: '/contacto', label: 'Contacto' }
];
const path = Astro.url.pathname;
---
<header class="border-b border-[var(--color-line)]">
  <div class="wrap flex items-center justify-between py-5">
    <a href="/" class="font-display text-lg font-semibold">
      <!-- TODO: reemplazar por tu nombre real -->
      [Tu Nombre]
    </a>
    <nav class="flex items-center gap-5 text-sm">
      {nav.slice(1).map((item) => (
        <a
          href={item.href}
          class:list={[
            'transition-colors hover:text-[var(--color-accent)]',
            path === item.href || (item.href !== '/' && path.startsWith(item.href))
              ? 'text-[var(--color-accent)] font-medium'
              : 'text-[var(--color-ink-muted)]'
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
