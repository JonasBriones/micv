---
interface Props {
  num: string;
  slug: string;
  title: string;
  description: string;
}
const { num, slug, title, description } = Astro.props;
---
<article class="group rounded-2xl border border-line bg-bg-card p-7 transition-all duration-300 hover:-translate-y-1 hover:border-accent hover:shadow-card">
  <div class="flex items-start justify-between">
    <span class="font-display text-3xl text-line" aria-hidden="true">{num}</span>
    <span class="rounded-full border border-line bg-bg px-3 py-1 text-[11px] uppercase tracking-wider text-ink-muted">{slug}</span>
  </div>
  <h3 class="mt-5 font-display text-2xl font-semibold group-hover:text-accent">{title}</h3>
  <p class="mt-3 text-sm leading-relaxed text-ink-muted">{description}</p>
</article>
