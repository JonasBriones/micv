---
import ProyectoCard from '@/components/ProyectoCard.astro';
---
<section id="proyectos" class="scroll-mt-24 border-y border-line bg-bg-soft px-5 py-20 sm:px-8 md:py-24">
  <div class="mx-auto max-w-6xl">
    <div class="reveal mb-10 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.22em] text-accent">04 / Proyectos</p>
        <h2 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">En los que trabajo hoy</h2>
      </div>
      <p class="max-w-md text-sm leading-relaxed text-ink-muted">Mención de proyectos propios, sin detalle operativo.</p>
    </div>

    <div class="reveal grid gap-5 md:grid-cols-2">
      <ProyectoCard
        num="01"
        slug="pisuerga-digital"
        title="Pisuerga Digital"
        description="Mi agencia. Desarrollo de producto y presencia digital para negocios locales."
      />
      <ProyectoCard
        num="02"
        slug="sazon-erp"
        title="Sazón ERP"
        description="ERP para restaurantes — gestión de recetas, costes, inventario y equipo."
      />
    </div>
  </div>
</section>
