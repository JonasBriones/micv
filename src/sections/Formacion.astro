---
import DisponibilidadCard from '@/components/DisponibilidadCard.astro';
---
<section id="formacion" class="scroll-mt-24 px-5 py-20 sm:px-8 md:py-24">
  <div class="mx-auto grid max-w-6xl gap-10 md:grid-cols-3 md:gap-8">
    <div class="reveal">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.22em] text-accent">05 / Formación</p>
      <h2 class="font-display text-3xl font-semibold tracking-tight">Formación académica</h2>
      <ul class="mt-6 space-y-5">
        <li class="border-l-2 border-accent pl-4">
          <h3 class="font-display text-lg font-semibold">Diplomado Lean Enterprise</h3>
          <p class="mt-1 text-sm text-ink-muted">Universidad Católica · 2020 — 2021</p>
        </li>
        <li class="border-l-2 border-accent pl-4">
          <h3 class="font-display text-lg font-semibold">Ingeniería de Ejecución en Informática</h3>
          <p class="mt-1 text-sm text-ink-muted">IP Santo Tomás · 2010 — 2015</p>
        </li>
      </ul>
    </div>
    <div class="reveal" style="transition-delay:.08s">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.22em] text-accent">Idiomas</p>
      <h2 class="font-display text-3xl font-semibold tracking-tight">Idiomas</h2>
      <div class="mt-6 rounded-2xl border border-line bg-bg-card p-6">
        <p class="font-display text-lg font-semibold">Español</p>
        <p class="mt-1 text-sm text-ink-muted">Nativo</p>
      </div>
    </div>
    <div class="reveal" style="transition-delay:.16s">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.22em] text-accent">Disponibilidad</p>
      <h2 class="font-display text-3xl font-semibold tracking-tight">Dónde trabajar</h2>
      <DisponibilidadCard />
    </div>
  </div>
</section>
