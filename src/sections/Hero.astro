---
import ProfileTerminalCard from '@/components/ProfileTerminalCard.astro';
import TechMarquee from '@/components/TechMarquee.astro';
---
<section id="inicio" class="scroll-mt-24">
  <div class="mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-8 md:grid-cols-[1.1fr_0.9fr] md:items-center md:py-24">
    <div class="reveal">
      <p class="mb-5 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.22em] text-accent">
        <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
        Líder Técnico · Arquitectura Cloud · DevOps &amp; FinOps
      </p>
      <h1 class="font-display text-4xl font-semibold leading-[1.12] tracking-tight sm:text-5xl lg:text-6xl">
        Tecnología que <span class="text-accent underline decoration-accent/30 decoration-4 underline-offset-8">sostiene</span> el negocio.
      </h1>
      <p class="mt-7 max-w-xl text-base leading-relaxed text-ink-muted sm:text-lg">
        Arquitecto de Soluciones Cloud, Líder Técnico y Backend Developer con más de 13 años diseñando, implementando y modernizando infraestructuras en AWS. Automatización, Kubernetes e Infrastructure as Code con foco en seguridad, observabilidad y costes.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href="#experiencia" class="rounded-full bg-accent px-6 py-3 text-sm font-medium text-bg shadow-card transition-colors hover:bg-accent-light focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">Ver trayectoria</a>
        <a href="#contacto" class="rounded-full border border-line bg-bg-card px-6 py-3 text-sm font-medium text-ink transition-colors hover:border-accent hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">Hablemos</a>
      </div>
      <div class="mt-9 flex flex-wrap gap-2 text-xs text-ink-muted">
        <span class="rounded-full border border-line bg-bg-card px-3 py-1.5">Valladolid, España</span>
        <span class="rounded-full border border-line bg-bg-card px-3 py-1.5">Híbrido o remoto</span>
        <span class="rounded-full border border-line bg-bg-card px-3 py-1.5">13+ años en cloud</span>
      </div>
    </div>

    <div class="reveal" style="transition-delay:.1s">
      <ProfileTerminalCard />
    </div>
  </div>

  <TechMarquee />
</section>
