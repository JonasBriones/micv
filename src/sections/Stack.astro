---
import SkillTabs from '@/components/SkillTabs.astro';
---
<section id="stack" class="scroll-mt-24 border-y border-line bg-bg-soft px-5 py-20 sm:px-8 md:py-24">
  <div class="mx-auto max-w-6xl">
    <div class="reveal mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.22em] text-accent">02 / Stack</p>
        <h2 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">Competencias técnicas</h2>
      </div>
      <p class="text-sm text-ink-muted">Selecciona una categoría para ver el detalle.</p>
    </div>

    <div class="reveal">
      <SkillTabs />
    </div>
  </div>
</section>
