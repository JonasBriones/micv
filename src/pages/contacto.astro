---
import Layout from '@/layouts/Layout.astro';

const email = 'jbrionestecnico@gmail.com';
const phone = '614215322';
const linkedin = 'https://www.linkedin.com/in/jonathan-patricio-briones-lavados';
const github = 'https://github.com/JonasBriones';
---
<Layout title="Contacto — Jonathan Briones" description="Hablemos de arquitectura cloud, DevOps, FinOps o liderazgo técnico. Jonathan Briones, Valladolid.">
  <section class="wrap py-16">
    <h1 class="font-display text-3xl font-semibold mb-4">Contacto</h1>
    <p class="text-ink-muted max-w-xl mb-10">
      Abierto a colaboraciones en desarrollo de software y consultoría tecnológica:
      arquitectura cloud, DevOps, FinOps o liderazgo técnico de equipos.
    </p>

    <div class="flex flex-col gap-4 max-w-sm">
      <a href={`mailto:${email}`} class="btn btn-primary justify-center">Escríbeme un email</a>
      <a href={`tel:${phone}`} class="btn btn-ghost justify-center">{phone}</a>
      <div class="flex gap-4 justify-center text-sm text-ink-muted">
        <a href={linkedin} class="hover:text-accent" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href={github} class="hover:text-accent" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>
  </section>
</Layout>
