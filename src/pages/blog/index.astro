---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Layout title="Blog — [Tu Nombre]" description="Tecnología, negocios y emprendimiento — desde España, con proyección internacional.">
  <section class="wrap py-16">
    <h1 class="font-display text-3xl font-semibold mb-10">Blog</h1>

    {posts.length === 0 && (
      <p class="text-[var(--color-ink-muted)]">Todavía no hay artículos publicados.</p>
    )}

    <ul class="space-y-10">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}`} class="group block">
            <p class="text-xs text-[var(--color-ink-muted)] mb-1">
              {post.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
            </p>
            <h2 class="font-display text-2xl font-semibold group-hover:text-[var(--color-accent)] transition-colors">
              {post.data.title}
            </h2>
            <p class="text-[var(--color-ink-muted)] mt-2">{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <div class="flex gap-2 mt-3">
                {post.data.tags.map((tag) => (
                  <span class="text-xs px-2 py-0.5 rounded-full border border-[var(--color-line)] text-[var(--color-ink-muted)]">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
