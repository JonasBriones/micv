---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---
<Layout>
  <section class="wrap pt-20 pb-16">
    <p class="text-sm uppercase tracking-widest text-[var(--color-ink-muted)] mb-4">
      Chileno en Valladolid · Construyendo cosas
    </p>
    <h1 class="font-display text-4xl sm:text-5xl font-semibold leading-tight max-w-2xl">
      <!-- TODO: esta es LA frase de la web. Reemplázala por tu propia frase potente. -->
      Construyo negocios y software con criterio, no con humo.
    </h1>
    <p class="mt-6 text-lg text-[var(--color-ink-muted)] max-w-xl">
      <!-- TODO: párrafo de apoyo — 2-3 líneas sobre qué haces hoy y por qué te importa -->
      Escribo sobre tecnología, negocios y el proceso (no solo el resultado) de emprender
      en España. Esta es mi web personal — separada de los proyectos en los que trabajo.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/blog" class="btn btn-primary">Leer el blog</a>
      <a href="/sobre-mi" class="btn btn-ghost">Sobre mí</a>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="wrap pb-20">
      <h2 class="font-display text-xl font-semibold mb-6">Últimas notas</h2>
      <ul class="space-y-6">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`} class="group block">
              <p class="text-xs text-[var(--color-ink-muted)] mb-1">
                {post.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
              </p>
              <h3 class="font-display text-lg font-medium group-hover:text-[var(--color-accent)] transition-colors">
                {post.data.title}
              </h3>
              <p class="text-sm text-[var(--color-ink-muted)] mt-1">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Layout>
